model Client {
  id                String           @id @default(uuid()) @db.VarChar(255)
  name              String           @db.VarChar(255)     // Se guarda en MAYÚSCULAS; letras
  status            Boolean          @default(true)
  client_points     Int              @default(0)
  ci                String?          @db.VarChar(20)      // Se guarda números
  nit               String?          @db.VarChar(20)      // Se guarda números
  description       String?          @db.VarChar(255)     // Se guarda en MAYÚSCULAS; letras, números y símbolos básicos (máx 255)
  address           String?          @db.VarChar(255)     // Se guarda en MAYÚSCULAS; letras, números y símbolos básicos (máx 255)
  cellphone         String?          @db.VarChar(20)      // Se guarda en +591 65325424
  telephone         String?          @db.VarChar(20)      // Se guarda en +591 65325424
  email             String?          @db.VarChar(255)
  
  clientCategoryId  String           @db.VarChar(255)
  tenantId          String           @db.VarChar(255)
  subsidiaryId      String           @db.VarChar(255)

  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  clientCategory    ClientCategory   @relation(fields: [clientCategoryId], references: [id])
  sales             Sale[]

  @@unique([name, tenantId, subsidiaryId])
  @@index([tenantId, subsidiaryId, clientCategoryId, status])
  @@index([tenantId])
  @@index([subsidiaryId])
}

model ClientCategory {
  id            String    @id @default(uuid()) @db.VarChar(255)
  name          String    @db.VarChar(255)
  status        Boolean   @default(true)
  description   String?   @db.VarChar(100)

  tenantId      String    @db.VarChar(255)
  subsidiaryId  String    @db.VarChar(255)

  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  clients       Client[]

  @@unique([name, tenantId, subsidiaryId])
  @@index([tenantId])
  @@index([subsidiaryId])
}