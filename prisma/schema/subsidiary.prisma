model Subsidiary {
  id                      String          @db.VarChar(255) @id  @default(uuid()) 
  status                  Boolean         @default(true) 
  subsidiary_type         SubsidiaryType
  maxUsers                Int             
  maxRoles                Int             

  name                    String          @db.VarChar(255)        // Se guarda en MAYÚSCULAS; letras, números y símbolos básicos (máx 255)
  shortname               String          @db.VarChar(10)         // minúsculas y dígitos [a-z0-9], 3–10, sin espacios/acentos
  nopCommerceStatus       Boolean         @default(false)
  allowNegativeStock      Boolean         @default(false)
  
  ci                      String?         @db.VarChar(20)         // Se guarda números
  nit                     String?         @db.VarChar(20)         // Se guarda números
  description             String?         @db.VarChar(255)        // Se guarda en MAYÚSCULAS; letras, números y símbolos básicos (máx 255)
  address                 String?         @db.VarChar(255)        // Se guarda en MAYÚSCULAS; letras, números y símbolos básicos (máx 255)
  city                    String?         @db.VarChar(20)         // Se guarda en MAYÚSCULAS; letras, números y símbolos básicos (máx 255)
  country                 String?         @db.VarChar(20)         // Se guarda en MAYÚSCULAS; letras, números y símbolos básicos (máx 255)
  cellphone               String?         @db.VarChar(20)         // Se guarda en +591 65325424
  telephone               String?         @db.VarChar(20)         // Se guarda en +591 65325424
  email                   String?         @db.VarChar(255)
  
  created_at              DateTime        @default(now())
  updated_at              DateTime        @updatedAt

  tenantId                String          @db.VarChar(255)
  tenant                  Tenant          @relation(fields: [tenantId], references: [id])

  users                   User[] 
  schedulesSubsidiaries   ScheduleSubsidiary[]    @relation(name: "ScheduleSubsidiaryForSubsidiary")

  @@unique([tenantId, name])
  @@unique([tenantId, shortname])

  @@index([tenantId]) 
}

enum SubsidiaryType {
  MATRIZ
  SUCURSAL
  ALMACEN
  OFICINA
}

model ScheduleSubsidiary {
  id              String        @id @db.VarChar(255) @default(uuid())

  status          Boolean       @default(true)
  start_day       DayOfWeek
  end_day         DayOfWeek
  opening_hour    String        @db.VarChar(5) // ejemplo: "08:00"
  closing_hour    String        @db.VarChar(5) // ejemplo: "16:30"

  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  tenantId        String        @db.VarChar(255) 

  subsidiary      Subsidiary    @relation(fields: [subsidiaryId], references: [id], name: "ScheduleSubsidiaryForSubsidiary")
  subsidiaryId    String        @db.VarChar(255)

  @@unique([subsidiaryId, start_day, end_day, opening_hour, closing_hour])

  @@index([tenantId]) 
  @@index([subsidiaryId])
}