model Product {
  id                        String           @id @default(uuid()) @db.VarChar(255)
  code                      String           @db.VarChar(255)
  barcode                   String?          @db.VarChar(255) // Código de barras físico (opcional)
  brand                     String           @db.VarChar(255) // marca
  name                      String           @db.VarChar(255)
  status                    Boolean          @default(false) 
  visibleInNopCommerce      Boolean          @default(false)
  description               String?          @db.Text
 
  productCategoryId         String           @db.VarChar(255) // FK a categoría del producto
  unitMeasurementId         String           @db.VarChar(255) // FK a unidad de medida
  tenantId                  String           @db.VarChar(255) // ID del tenant al que pertenece
  subsidiaryId              String           @db.VarChar(255) // ID de la sucursal donde aplica

  created_at                DateTime         @default(now()) // Fecha de creación del registro
  updated_at                DateTime         @updatedAt // Fecha de última actualización

  // Relaciones
  productCategory           ProductCategory  @relation(fields: [productCategoryId], references: [id])
  unitMeasurement           UnitMeasurement  @relation(fields: [unitMeasurementId], references: [id])
  
  // META DE EMPAQUES (solo informativo, no numérico)
  packagingMin              String?          @db.VarChar(255)  // ej: "CAJITA (50 unidades)"
  packagingMax              String?          @db.VarChar(255)  // ej: "CAJA (50 cajitas)"
  
  purchaseDetails           PurchaseDetail[]
  saleDetails               SaleDetail[]
  inventory                 Inventory[]
  productPrices             ProductPrice[]
  images                    ProductImage[]

  @@unique([name, subsidiaryId]) 
  @@unique([code, subsidiaryId]) 
  @@unique([barcode, subsidiaryId])
  @@index([code])
  @@index([brand])
  @@index([name])
  @@index([status])
  @@index([visibleInNopCommerce])
  @@index([productCategoryId])
  @@index([unitMeasurementId])
  @@index([tenantId])
  @@index([subsidiaryId]) 
  @@index([tenantId, subsidiaryId, productCategoryId, status])
  @@index([tenantId, subsidiaryId, productCategoryId, visibleInNopCommerce])
}  

model ProductImage {
  id           String   @id @default(uuid()) @db.VarChar(255)
  productId    String   @db.VarChar(255)
  url          String   @db.Text            // ruta/URL al archivo (S3/DO Spaces/etc.)
  alt          String?  @db.VarChar(255)    // texto alternativo
  isPrimary    Boolean  @default(false)     // una foto principal por producto
  sortOrder    Int      @default(0)         // orden en galería

  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  product      Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@unique([productId, sortOrder]) // evita duplicar posiciones en la galería
}

model ProductCategory {
  id                    String           @id @default(uuid()) @db.VarChar(255) // ID único de la categoría
  name                  String           @db.VarChar(255) // Nombre de la categoría
  status                Boolean          @default(true) // Activa o inactiva
  description           String?          @db.Text

  created_at            DateTime         @default(now()) // Fecha de creación
  updated_at            DateTime         @updatedAt // Fecha de última actualización

  tenantId              String           @db.VarChar(255) // ID del tenant
  subsidiaryId          String           @db.VarChar(255) // ID de la sucursal

  products              Product[] // Productos que pertenecen a esta categoría

  @@unique([name, subsidiaryId]) // Nombre único por sucursal
  @@index([tenantId]) // Índice por tenant
  @@index([subsidiaryId]) // Índice por sucursal
}

model UnitMeasurement {
  id                    String           @id @default(uuid()) @db.VarChar(255)
  name                  String           @db.VarChar(50) // Nombre de la unidad (KG, LITRO, PACK)
  quantity              Int               // Ej: 1, 10, 100 (si es por pack)
  status                Boolean          @default(true) // Activa o inactiva

  created_at            DateTime         @default(now()) // Fecha de creación
  updated_at            DateTime         @updatedAt // Fecha de última actualización

  tenantId              String           @db.VarChar(255) // ID del tenant
  subsidiaryId          String           @db.VarChar(255) // ID de la sucursal

  products              Product[]

  @@unique([name, quantity, subsidiaryId])  // Nombre único por sucursal
  @@index([name])
  @@index([tenantId]) 
  @@index([subsidiaryId])
}

model PriceType {
  id                    String           @id @default(uuid()) @db.VarChar(255) // ID único del tipo de precio
  name                  String           @db.VarChar(50) // Nombre (Minorista, Mayorista, etc.)
  status                Boolean          @default(true) // Activo o inactivo

  productPrices         ProductPrice[]

  created_at            DateTime         @default(now()) // Fecha de creación
  updated_at            DateTime         @updatedAt // Fecha de actualización

  tenantId              String           @db.VarChar(255) // Tenant dueño del precio
  subsidiaryId          String           @db.VarChar(255) // Sucursal específica

  @@unique([name, subsidiaryId])
  @@index([subsidiaryId]) // Índice por sucursal
  @@index([tenantId]) // Índice por tenant
}

model ProductPrice {
  id           String  @id @default(uuid()) @db.VarChar(255)
  price        Decimal @db.Decimal(12, 2)   // PRECIO POR UNIDAD BASE

  marginPercent Decimal? @db.Decimal(7, 2)  // ((price - baseCostUsed)/baseCostUsed)*100
  baseCostUsed  Decimal? @db.Decimal(12, 2) // último precio de compra unitario

  productId    String  @db.VarChar(255)
  priceTypeId  String  @db.VarChar(255)
  tenantId     String  @db.VarChar(255)
  subsidiaryId String  @db.VarChar(255)

  product      Product   @relation(fields: [productId], references: [id])
  priceType    PriceType @relation(fields: [priceTypeId], references: [id])

  @@unique([productId, priceTypeId, subsidiaryId])
  @@index([productId])
  @@index([priceTypeId])
  @@index([subsidiaryId])
  @@index([tenantId])
}
