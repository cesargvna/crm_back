model User {
  id              String       @db.VarChar(255) @id  @default(uuid())
  status          Boolean      @default(true) 
  isNopCommerce   Boolean      @default(false)
  username        String       @unique @db.VarChar(20)      // letra minúsculas y dígitos [a-z0-9], 3–10, sin espacios/acentos
  password        String       @db.VarChar(255)
  name            String       @db.VarChar(255)             // Se guarda en MAYÚSCULAS; letras sin acentos(máx 255)

  ci              String?      @db.VarChar(20)              // Se guarda números
  nit             String?      @db.VarChar(20)              // Se guarda números
  jobPosition     String?      @db.VarChar(100)             // Se guarda en MAYÚSCULAS; letras sin acentos(máx 100)
  description     String?      @db.VarChar(255)             // Se guarda en MAYÚSCULAS; letras, números y símbolos básicos (máx 255)
  address         String?      @db.VarChar(255)             // Se guarda en MAYÚSCULAS; letras, números y símbolos básicos (máx 255
  cellphone       String?      @db.VarChar(20)              // Se guarda en +591 65325424
  email           String?      @db.VarChar(255)

  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  role            Role         @relation(fields: [roleId], references: [id])
  roleId          String       @db.VarChar(255)

  subsidiary        Subsidiary   @relation(fields: [subsidiaryId], references: [id])
  subsidiaryId      String       @db.VarChar(255)

  tenantId          String       @db.VarChar(255)
  
  schedulesUsers    ScheduleUser[]    @relation(name: "ScheduleUserForUser")
  cashSessions      CashSession[] 
  sales             Sale[]
  expenses          Expense[]
  incomes           Income[]
  purchases         Purchase[]

  @@index([tenantId]) 
  @@index([subsidiaryId])
  @@index([jobPosition])
  @@index([username])
  @@index([tenantId, subsidiaryId, status])
  @@index([tenantId, subsidiaryId, isNopCommerce])
  @@index([tenantId, subsidiaryId, roleId])
}

model ScheduleUser {
  id                String        @id @db.VarChar(255) @default(uuid())
  status            Boolean       @default(true)
  start_day         DayOfWeek
  end_day           DayOfWeek
  opening_hour      String        @db.VarChar(5) // ejemplo: "08:00"
  closing_hour      String        @db.VarChar(5) // ejemplo: "16:30"
  
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  tenantId          String       @db.VarChar(255) // 👉 agregado sin relación
  subsidiaryId      String       @db.VarChar(255) 

  user              User          @relation(fields: [userId], references: [id], name: "ScheduleUserForUser")
  userId            String        @db.VarChar(255)

  @@index([tenantId]) 
  @@index([subsidiaryId])

  @@unique([userId, start_day, end_day, opening_hour, closing_hour])
}

enum DayOfWeek {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}