model CashSession {
  id                     String      @id @default(uuid()) @db.VarChar(255)
  userId                 String      @db.VarChar(255)
  tenantId               String      @db.VarChar(255) 
  subsidiaryId           String      @db.VarChar(255)

  openDateTime           DateTime    @default(now()) // Fecha y hora reales de apertura
  closeDateTime          DateTime?   // Fecha y hora reales de cierre (solo se actualiza al cerrar)

  status                 Boolean     @default(true)

  initialAmount          Decimal     @db.Decimal(12, 2)
  salesCash              Decimal     @default(0) @db.Decimal(12, 2)
  totalCreditPayments    Decimal     @default(0) @db.Decimal(12, 2)
  creditGivenToday       Decimal     @default(0) @db.Decimal(12, 2)
  systemAmount           Decimal     @default(0) @db.Decimal(12, 2)
  countedAmount          Decimal?    @db.Decimal(12, 2)
  difference             Decimal?    @db.Decimal(12, 2)
  note                   String?     @db.VarChar(255)

  created_at             DateTime    @default(now())
  updated_at             DateTime    @updatedAt // Correcto: controla la última edición de cualquier campo

  user                   User        @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([subsidiaryId])
  @@index([userId])
  @@index([userId, status, openDateTime])
  @@index([tenantId, subsidiaryId, userId, status, closeDateTime])
}