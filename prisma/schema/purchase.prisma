model Purchase {
  id                    String                  @id @default(uuid()) @db.VarChar(255)
  code                  String                  @db.VarChar(20) // Código de compra único por fecha y sucursal  YYYY-MM-DD-00001
  discountType          DiscountType            // Enum PORCENTAJE CANTIDAD
  discountValue         Decimal?                @db.Decimal(12, 2)
  total                 Decimal                 @db.Decimal(12, 2)
  note                  String?                 @db.VarChar(255)

  purchaseDate          DateTime                             
  paymentType           PaymentType             // Enum CONTADO / CREDITO
  purchaseStatus        PurchaseStatus          // Enum CONFIRMADA / DEVUELTA 
  paymentStatus         PaymentStatus           // Enum PENDIENTE / PARCIAL / COMPLETO

  created_at            DateTime                @default(now())
  updated_at            DateTime                @updatedAt

  cashSessionId         String?                 @db.VarChar(255) // ← campo referencial sin relación cruzada
  supplierId            String                  @db.VarChar(255)
  userId                String                  @db.VarChar(255)
  subsidiaryId          String                  @db.VarChar(255)
  tenantId              String                  @db.VarChar(255) 
  
  supplier              Supplier                @relation(fields: [supplierId], references: [id])
  user                  User                    @relation(fields: [userId], references: [id])
  purchaseDetails       PurchaseDetail[]
  creditPayments        PurchaseCreditPayment[]
  images                PurchaseImage[]

  @@unique([tenantId, subsidiaryId, code])
  @@index([purchaseDate])
  @@index([paymentStatus]) 
  @@index([cashSessionId])
  @@index([supplierId])
  @@index([userId])
  @@index([subsidiaryId])
  @@index([tenantId])
  @@index([tenantId, subsidiaryId, paymentStatus])  // útil
  @@index([tenantId, subsidiaryId, purchaseDate])   // útil
}

model PurchaseDetail {
  id                     String       @id @default(uuid()) @db.VarChar(255)
  price                  Decimal      @db.Decimal(12, 2)
  quantity               Int
  subtotal              Decimal      @db.Decimal(12, 2)
  
  cashSessionId          String?      @db.VarChar(255) 
  productId              String       @db.VarChar(255)
  purchaseId             String       @db.VarChar(255)
  userId                 String       @db.VarChar(255)
  supplierId             String       @db.VarChar(255)
  subsidiaryId           String       @db.VarChar(255)
  tenantId               String       @db.VarChar(255) 

  created_at             DateTime     @default(now())
  updated_at             DateTime     @updatedAt

  purchase               Purchase     @relation(fields: [purchaseId], references: [id])
  product                Product      @relation(fields: [productId], references: [id])

  @@unique([purchaseId, productId])  

  @@index([cashSessionId])
  @@index([productId])
  @@index([purchaseId])
  @@index([userId])
  @@index([supplierId])
  @@index([subsidiaryId])
  @@index([tenantId])
}

model PurchaseImage {
  id          String    @id @default(uuid()) @db.VarChar(255)
  purchaseId  String    @db.VarChar(255)
  url         String    @db.Text

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  purchase    Purchase  @relation(fields: [purchaseId], references: [id])

  @@index([purchaseId])
}

model PurchaseCreditPayment {
  id                String        @id @default(uuid()) @db.VarChar(255)
  amount            Decimal       @db.Decimal(12, 2)
  paymentDate       DateTime       

  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  
  cashSessionId     String?       @db.VarChar(255)// ← campo referencial sin relación cruzada
  supplierId        String        @db.VarChar(255)
  userId            String        @db.VarChar(255)
  purchaseId        String        @db.VarChar(255)
  subsidiaryId      String        @db.VarChar(255) // Sucursal específica
  tenantId          String        @db.VarChar(255) // Tenant dueño del pago

  purchase          Purchase      @relation(fields: [purchaseId], references: [id])

  @@index([cashSessionId])
  @@index([paymentDate]) 
  @@index([supplierId])
  @@index([userId])
  @@index([purchaseId])
  @@index([subsidiaryId])
  @@index([tenantId])
}

enum PurchaseStatus {
  CONFIRMADA  
  DEVUELTA     
}

enum DiscountType {
  PORCENTAJE
  CANTIDAD
}