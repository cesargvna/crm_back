model Sale {
  id                   String               @id @default(uuid()) @db.VarChar(255)
  total                Decimal              @db.Decimal(10, 2) // Total venta
  note                 String?              @db.VarChar(255) // Nota opcional

  saleDate             DateTime             @default(now()) // Fecha de venta
  paymentType          PaymentType          // Enum CONTADO / CREDITO
  dispatchStatus       DispatchStatus       // Enum COMPLETADA / ANULADA
  paymentStatus        PaymentStatus        // Enum PENDIENTE / PARCIAL / COMPLETO
  
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt
  
  tenantId             String               @db.VarChar(255) // Tenant dueño de la venta
  subsidiaryId         String               @db.VarChar(255) // Sucursal específica
  clientId             String               @db.VarChar(255) // FK a cliente
  userId               String               @db.VarChar(255) // FK a usuario
  
  client               Client               @relation(fields: [clientId], references: [id])
  user                 User                 @relation(fields: [userId], references: [id])
  saleDetails          SaleDetail[]
  saleCreditPayments       SaleCreditPayment[]

  @@index([tenantId])
  @@index([subsidiaryId])
  @@index([userId])
}

enum PaymentType {
  CONTADO
  CREDITO
}

enum DispatchStatus {
  COMPLETADA // venta realizada (activa)
  ANULADA    // venta cancelada (reversada)
}

enum PaymentStatus {
  PENDIENTE   // aún no se paga nada
  PARCIAL     // se ha pagado una parte
  COMPLETO    // se pagó todo el crédito
}

model SaleDetail {
  id                    String               @id @default(uuid()) @db.VarChar(255)
 
  unit_price            Decimal              @db.Decimal(10, 2)
  quantity              Int
  subtotal              Decimal              @db.Decimal(10, 2)
  
  saleId                String               @db.VarChar(255)
  productId             String               @db.VarChar(255)
  userId                String               @db.VarChar(255)
  tenantId              String               @db.VarChar(255) // Tenant dueño de la venta
  subsidiaryId          String               @db.VarChar(255) // Sucursal específica
  
  
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt

  sale                  Sale                 @relation(fields: [saleId], references: [id])
  product               Product              @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([subsidiaryId])
  @@index([userId])
  @@index([productId])
}

model SaleCreditPayment {
  id                   String       @id @default(uuid()) @db.VarChar(255)
  saleId               String       @db.VarChar(255)
  amount               Decimal      @db.Decimal(10, 2)
  paymentDate          DateTime     @default(now())

  tenantId             String       @db.VarChar(255) // Tenant dueño del pago
  subsidiaryId         String       @db.VarChar(255) // Sucursal específica

  sale                 Sale         @relation(fields: [saleId], references: [id])

  @@index([tenantId])
  @@index([subsidiaryId])
}