model Expense {
  id                    String           @id @default(uuid()) @db.VarChar(255)
  name                  String           @db.VarChar(255)
  description           String?          @db.VarChar(255)

  quantity              Int              @default(1)          
  unit_price            Decimal          @db.Decimal(12, 2)         
  total_amount          Decimal          @db.Decimal(12, 2)

  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt
  
  cashSessionId         String?          // ← campo referencial sin relación cruzada
  expenseCategoryId     String
  userId                String
  tenantId              String           @db.VarChar(255)
  subsidiaryId          String           @db.VarChar(255)
  
  expenseCategory       ExpenseCategory  @relation(fields: [expenseCategoryId], references: [id])
  user                  User             @relation(fields: [userId], references: [id])

  images           ExpenseImage[]

  @@index([tenantId])
  @@index([subsidiaryId])
  @@index([userId])
  @@index([tenantId, subsidiaryId, expenseCategoryId])
  @@index([cashSessionId])
}

model ExpenseImage {
  id              String        @id @default(uuid()) @db.VarChar(255)
  expenseId       String        @db.VarChar(255)
  url             String        @db.Text

  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  expense         Expense       @relation(fields: [expenseId], references: [id])

  @@index([expenseId])
}

model ExpenseCategory {
  id                    String           @id @default(uuid()) @db.VarChar(255)
  name                  String           @db.VarChar(255)
  status                Boolean          @default(true)
  description           String?          @db.VarChar(255)

  tenantId              String           @db.VarChar(255) 
  subsidiaryId          String           @db.VarChar(255)
   
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt

  expenses              Expense[] 

  @@unique([name, tenantId, subsidiaryId])
  @@index([tenantId])
  @@index([subsidiaryId])
}